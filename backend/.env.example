# Local (non-Docker) backend settings. Copy to backend/.env - never commit the real file.

# --- Database ---
# Leave unset to fall back to a local SQLite file.
DATABASE_URL=sqlite:///./campusbite.db

# Only read by docker-compose
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
POSTGRES_DB=campusbite

# --- Auth ---
# Any long random string works, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- AI order insights (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=5

# --- CORS: comma-separated frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- Stale-order watcher ---
REMINDER_THRESHOLD_MINUTES=15
REMINDER_INTERVAL_SECONDS=60
